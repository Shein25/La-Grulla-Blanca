{
  "schema": "ULTIMATE_REPERTOIRE_CONTRACT_V01",
  "status": "HUMAN_DECISION_FROZEN_FOR_FUTURE_TESTS",
  "date": "2026-10-05",
  "scope": "player ultimate repertoire, unlock eligibility and per-combat use budget",
  "rules": {
    "max_equipped_ultimates": 2,
    "slots": [
      {
        "slot": "PRIMARY_ELEMENT_ULTIMATE",
        "element_source": "primary_element",
        "max_equipped": 1
      },
      {
        "slot": "GRAFTED_ELEMENT_ULTIMATE",
        "element_source": "grafted_element",
        "max_equipped": 1
      }
    ],
    "shared_ultimate_use_budget_per_combat": 1,
    "successful_activation_consumes_shared_budget": true,
    "after_budget_consumed": "ALL_OTHER_EQUIPPED_ULTIMATES_LOCKED_FOR_REMAINDER_OF_COMBAT",
    "ultimates_are_alternatives_not_a_combo_chain": true,
    "existing_per_ultimate_out_of_combat_cooldown_authority": "PRESERVE_EXISTING_AUTHORITY"
  },
  "unlock_eligibility": {
    "mastery_definition": {
      "rule": "PLAYER_HAS_PROGRESS_REQUIRED_TO_BE_CAPABLE_OF_ASSIGNING_AT_LEAST_ONE_POINT_TO_EACH_SPECIALIZATION_IN_THE_ELEMENT_BRANCH",
      "actual_point_spend_in_every_specialization_required": false
    },
    "primary_ultimate": {
      "minimum_stage": "LIANQI_III",
      "requires_primary_branch_full_mastery": true,
      "automatic_on_stage_reach": false
    },
    "grafted_ultimate": {
      "minimum_stage": "LIANQI_IV",
      "requires_existing_elemental_graft": true,
      "requires_grafted_branch_full_mastery": true,
      "automatic_on_stage_reach": false
    }
  },
  "stage_envelope": {
    "before_primary_mastery": "NO_PRIMARY_ULTIMATE",
    "lianqi_iii_with_primary_mastery": "PRIMARY_ULTIMATE_ELIGIBLE",
    "lianqi_iii_with_graft": "GRAFTED_ULTIMATE_NOT_YET_ELIGIBLE_BY_STAGE",
    "lianqi_iv_with_graft_and_grafted_mastery": "GRAFTED_ULTIMATE_ELIGIBLE"
  },
  "not_yet_authorized": {
    "rejected_or_not_activated_attempt_consumes_shared_budget": "AUTHORITY_REQUIRED",
    "same_primary_and_grafted_element_is_legal": "AUTHORITY_REQUIRED",
    "concrete_ultimate_acquisition_or_selection_after_mastery": "AUTHORITY_REQUIRED"
  },
  "future_balance_implication": {
    "test_unit": "TWO_ULTIMATE_REPERTOIRE_WITH_ONE_SHARED_USE_WHEN_BOTH_ARE_ACTUALLY_UNLOCKED",
    "must_compare_choice_not_sequence": true,
    "must_respect_stage_and_mastery_eligibility": true,
    "must_measure": [
      "ULTIMATE_UNLOCK_ELIGIBILITY",
      "ULTIMATE_CHOICE_SHARE",
      "ULTIMATE_OPPORTUNITY_REGRET",
      "ULTIMATE_UNUSED_RATE",
      "PRIMARY_ULTIMATE_USE_RATE",
      "GRAFTED_ULTIMATE_USE_RATE",
      "ULTIMATE_PHASE_OF_USE",
      "F3_PACT_INTERACTION",
      "POST_ULTIMATE_SURVIVAL_AND_BOSS_STATE"
    ]
  },
  "guards": {
    "no_auto_nerf_or_buff": true,
    "human_decisions_prevail": true,
    "v031_validated_runner_is_immutable_evidence": true
  }
}
