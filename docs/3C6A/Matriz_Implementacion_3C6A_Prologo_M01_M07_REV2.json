  "decisiones_humanas": [
    {
      "id": "DHP_3C6_01",
      "estado": "CERRADA",
      "decision": "CONSAGRAR deja de reducir el qi acumulado. LI→LII usa etapa>=2 como evidencia mecánica de haber alcanzado el umbral de 25."
    },
    {
      "id": "DHP_3C6_02",
      "estado": "CERRADA",
      "decision": "servicioTerritorial=COMPLETADO cuando M04 y M05 están HECHAS; M05 se habilita al cerrar M04."
    },
    {
      "id": "DHP_3C6_03",
      "estado": "CERRADA",
      "decision": "evidenciaTerritorial es monotónica: INSUFICIENTE < SUFICIENTE < CONCLUYENTE; gates usan >=SUFICIENTE; campo único informeFronteraAceptado."
    },
    {
      "id": "DHP_3C6_04",
      "estado": "CERRADA",
      "decision": "LI→LII y LII→LIII son transiciones one-shot con presentación visual ceremonial. M07 no abre SECTA_INTERIOR."
    },
    {
      "id": "DHP_3C6_05",
      "estado": "CERRADA",
      "decision": "2→3 requiere qi=45, Píldora de Consolidación, M04+M05, evidencia>=SUFICIENTE e informe aceptado. Se elimina el logro genérico de combate como hard-gate."
    },
    {
      "id": "DHP_3C6_06",
      "estado": "CERRADA",
      "decision": "La raíz se asigna determinísticamente por tres elecciones de diagnóstico; la reacción final ante la Piedra desempata. Sin RNG. Guardia y ayudante quedan como roles genéricos."
    },
    {
      "id": "DHP_3C6_07",
      "estado": "CERRADA",
      "decision": "Madre Wen es la encargada de externos, no la madre biológica. M01 usa registro→sala_jade→patio→patio_cabanas→corredor_cabanas→dormitorio_externos; corredor sólo tránsito."
    },
    {
      "id": "DHP_3C6_08",
      "estado": "CERRADA",
      "decision": "M02 usa la rata de despensa como encuentro tutorial. Tras morir/cerrar M02 no reaparece; no EXTRAER; no bestiario/Atlas/registro; cadáver controlado hasta completar Examen."
    },
    {
      "id": "DHP_3C6_09",
      "estado": "CERRADA",
      "decision": "Condiciones básicas: room sin hostiles vivos y sin combate activo. Piel de Cobre se aprende por primera vez en M03 con Shen Baojun."
    },
    {
      "id": "DHP_3C6_10",
      "estado": "CERRADA",
      "decision": "M04 se asigna/entrega con Jiang Rui en puesto_valle; Gao Shun es checkpoint en puerta; M05 la asigna Duan Shibo desde oficina_logistica y termina con Xu An en Sauces."
    },
    {
      "id": "DHP_3C6_11",
      "estado": "CERRADA",
      "decision": "Evidencia por diversidad: 1 tipo=INSUFICIENTE; 2=INSUFICIENTE/sospecha fuerte; 3=SUFICIENTE; 4=CONCLUYENTE; repetir tipo no suma."
    },
    {
      "id": "DHP_3C6_12",
      "estado": "CERRADA",
      "decision": "M07 se presenta en pabellon_disciplina con Qiao Ren + Jiang Rui; He Zhen recibe copia. Jiang/Qiao R1=CONFIRMADO; He Zhen/Ren Bo/Su Lian R1=SABE."
    },
    {
      "id": "DHP_3C6_13",
      "estado": "CERRADA",
      "decision": "Balance: M02 +1 contrib.; M03 0; M04 +2 contrib. (+1 mérito opcional); M05 +3 contrib. + píldora; M06 +2 contrib. +1 mérito; M07 +4 contrib. +3 mérito +1 Comprensión."
    },
    {
      "id": "DHP_3C6_14",
      "estado": "CERRADA",
      "decision": "QUESTS define P–M07; this.quests persiste activa/hecha; BLOQUEADA/DISPONIBLE derivadas; flags guarda arc1/permisos/evidencia; SAVE_SCHEMA_VERSION sigue en 2."
    },
    {
      "id": "DHP_3C6_15",
      "estado": "CERRADA",
      "decision": "Inicio: título Aspirante, afiliación PENDIENTE_REGISTRO y sin rango. Fin P: ADMITIDO. M01: ASPIRANTE. M03: DISCIPULO_EXTERNO + MIEMBRO. Uniforme/espada se reciben en descansillo."
    },
    {
      "id": "DHP_3C6_16",
      "estado": "CERRADA",
      "decision": "dormitorio_externos se asigna en M01 y queda conocido+visitado. SECTA_EXTERIOR_BASE y PATRULLA_TERRITORIAL son permisos institucionales, no gates físicos."
    },
    {
      "id": "DHP_3C6_17",
      "estado": "CERRADA",
      "decision": "Subsistema social opcional paralelo. Afinidad no bloquea progreso. Prioridad CRISIS > misión principal > personal > ambiental. Máximo una escena social importante por entrada. Géneros: Lin F, Han M, Zhao M, Mei F, Guo M, Luo M."
    }
  ],
